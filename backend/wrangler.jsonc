{
  "name": "quiz-redes2-api",
  "main": "src/worker.py",
  "compatibility_date": "2026-08-27",
  // URL pública *.workers.dev (es la que va en VITE_API_URL del front)
  "workers_dev": true,
  "compatibility_flags": ["python_workers"],
  "build": {
    "command": "uv run pywrangler sync"
  },
  "observability": {
    "logs": { "enabled": true }
  },
  "vars": {
    // Development instance of the linked Clerk application.
    "CLERK_ISSUER": "https://eminent-ocelot-2803.clerk.accounts.dev",
    "CLERK_JWKS_URL": "https://eminent-ocelot-2803.clerk.accounts.dev/.well-known/jwks.json"
  }
  // Keep DATABASE_URL in backend/.dev.vars for local development and as a Worker secret in production.
}
